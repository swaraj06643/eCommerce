DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use the local SQLite database. Set this to the Neon PostgreSQL URL.
# Uncomment and replace with your Neon PostgreSQL URL when ready.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require
DB_CONN_MAX_AGE=60

# In local DEBUG mode, leave SMTP unset to print verification links in the terminal.
# Set these values to enable real email delivery.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-app-password
# DEFAULT_FROM_EMAIL=your-email@example.com
